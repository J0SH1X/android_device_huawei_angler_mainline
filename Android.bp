soong_namespace {
}

// Modem firmware lives on the vfat modem partition (/vendor/firmware_mnt/image).
// Symlink it into the kernel's direct-load path so remoteproc never depends on
// ueventd's 1 s sysfs fallback.
install_symlink {
    name: "angler_modem_fw_mba_b00",
    vendor: true,
    installed_location: "firmware/mba.b00",
    symlink_target: "/vendor/firmware_mnt/image/mba.b00",
}

install_symlink {
    name: "angler_modem_fw_mba_mdt",
    vendor: true,
    installed_location: "firmware/mba.mdt",
    symlink_target: "/vendor/firmware_mnt/image/mba.mdt",
}

install_symlink {
    name: "angler_modem_fw_modem_b00",
    vendor: true,
    installed_location: "firmware/modem.b00",
    symlink_target: "/vendor/firmware_mnt/image/modem.b00",
}

