# System
system   /system     ext4    ro,barrier=1        wait,logical,first_stage_mount
vendor   /vendor     ext4    ro,barrier=1        wait,logical,first_stage_mount
product  /product    ext4    ro,barrier=1        wait,logical,first_stage_mount
system_ext  /system_ext    ext4    ro,barrier=1        wait,logical,first_stage_mount
#/dev/block/by-name/system /system ext4 noatime,ro first_stage_mount
#/dev/block/by-name/vendor /vendor ext4 noatime,ro first_stage_mount

# Cache
/dev/block/by-name/cache /cache ext4 nodev,noatime,nosuid,discard check,formattable

# Persist
/dev/block/by-name/boot /boot emmc defaults defaults
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/modem /vendor/firmware_mnt vfat ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337 defaults
/dev/block/by-name/persist /mnt/vendor/persist ext4 nosuid,nodev,noatime,ro defaults
/dev/block/by-name/recovery /recovery emmc defaults defaults

# SDcard
/devices/platform/soc@0/78db000.usb/*/usb* auto auto defaults voldmanaged=usb:auto,noemulatedsd

# Userdata
/dev/block/by-name/vendor /metadata ext4 nodev,noatime,nosuid,discard,data=journal,commit=1 check,formattable,first_stage_mount,metadata_csum
/dev/block/by-name/userdata /data ext4 nodev,noatime,nosuid,discard latemount,check,quota,formattable

# ZRAM
/dev/block/zram0 none swap defaults zramsize=50%
