import /vendor/etc/init/hw/init.mainline.qcom.rc

# Kernel module loading
on post-fs
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -s -d /vendor/lib/modules --all=/vendor/etc/modules.load.normal

# Boot the remoteprocs once rmtfs (modem EFS) is serving; modem.mdt/mba.b00 are
# reachable through /vendor/firmware symlinks into the modem partition.
on property:init.svc.vendor.rmtfs=running
    trigger start_all_remoteproc

# Mount
on fs
    # Mount everything that does not require fsck
    mount_all --early

on late-fs
    # Mount RW partitions which need run fsck
    mount_all --late

# Speaker route (static until there is a real audio HAL with routing): ASM MultiMedia1 ->
# QUAT MI2S RX -> both MAX98925 amps (left 0x31 / right 0x34). Card N6P = card 0.
on property:sys.boot_completed=1
    exec - root audio -- /system/bin/tinymix2 -D 0 set "QUAT_MI2S_RX Audio Mixer MultiMedia1" 1
    exec - root audio -- /system/bin/tinymix2 -D 0 set "Left DAI IN MUX" 0
    exec - root audio -- /system/bin/tinymix2 -D 0 set "Right DAI IN MUX" 1
    exec - root audio -- /system/bin/tinymix2 -D 0 set "Left Speaker Volume" 20
    exec - root audio -- /system/bin/tinymix2 -D 0 set "Right Speaker Volume" 20
